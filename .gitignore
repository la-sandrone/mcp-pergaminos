# ── 凭据：永不入库 ─────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
credentials*
*_credential*

# ── 缓存与运行产物 ─────────────────────────────────────────────────
.cache/
cache/
*.log
__pycache__/
*.py[cod]
.venv/
venv/

# ── 备份（本项目惯例：就地 .bak-<后缀>）─────────────────────────────
*.bak
*.bak-*
*.pre-*

# ── 私人文稿 / 语料（本仓库不应含任何语料）─────────────────────────
*.jsonl
*.zip

# ── 编辑器 / 系统 ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
