# 复制为 .env 后填写。**.env 已在 .gitignore 中，永不入库。**
#
# 优先级：真实环境变量 > .env > 代码内兜底
# 变量名一律带 PERGAMINOS_ 前缀 —— 这是唯一的命名空间。
# 写错名字**不会静默**：启动打印会用 UNREAD 标出「写了但没有任何代码会读」的
# 变量，并给出正确写法。上一代项目的 PAPERSEARCH_* 会被识别为遗留并提示改名。

# ── 必填 ───────────────────────────────────────────────────────────
# Unpaywall 要求把 email 作为 URL 参数带走。任意可达邮箱即可，无需注册。
PERGAMINOS_UNPAYWALL_EMAIL=you@example.com

# ── 建议 ───────────────────────────────────────────────────────────
# User-Agent 里的联系方式。留空则复用 UNPAYWALL_EMAIL。
# Crossref 官方 best practice 要求 UA 能标识你与你的脚本
# （arXiv 的 Code of Conduct 同理）；写清楚比被当爬虫好。
# PERGAMINOS_CONTACT=you@example.com

# Crossref Polite 池：带上后限速从 5 req/s（并发 1）
# 提升到 10 req/s（并发 3）。留空则复用 CONTACT。
# PERGAMINOS_CROSSREF_MAILTO=you@example.com

# ── 可选：OpenAlex（默认关闭）─────────────────────────────────────
# 空 = 不启用。填 key 后才启用，用于补：跨源 ID 桥 / 含付费位置的
# locations[] / 一次 100 个 DOI 的批量查询。
# 免费 key：https://openalex.org/ 注册后见 settings/api。
# 注意：免费额度 $1/天且**无法在不付款的情况下提高**，撞顶要等到 UTC 午夜。
# PERGAMINOS_OPENALEX_KEY=

# ── 可选：代理 ─────────────────────────────────────────────────────
# 空 = 不挂。支持 http:// 与 socks5://（后者需 socksio，即 pip install 'httpx[socks]'）
# PERGAMINOS_PROXY=http://127.0.0.1:8994
# 按源豁免，逗号分隔（例如国内可达的源不必走代理）
# PERGAMINOS_PROXY_BYPASS=arxiv,crossref

# ── 可选：超时与缓存 ───────────────────────────────────────────────
# 单次请求超时
# PERGAMINOS_TIMEOUT_MS=20000
# 每个源的总预算（含全部重试）。预算是闸门，不是目标：
# 超了就放弃该源，不拖累其它源。
# PERGAMINOS_PER_SOURCE_TIMEOUT_MS=90000
# PERGAMINOS_CACHE_TTL_H=168
# PERGAMINOS_LOG_LEVEL=INFO
